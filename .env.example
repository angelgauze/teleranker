# Copy to `.env` and set the URLs for your PostgreSQL database.
# Never commit the real `.env` file. `neon deploy` fills these in for Neon.

# Application traffic. On Neon this is the pooled (-pooler) connection string,
# which the app uses through src/lib/db/client.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/teleranker?schema=public"

# Prisma CLI commands (migrate, studio) and database setup scripts. On Neon this
# is the direct connection string without the `-pooler` suffix. Optional for a
# local database: when unset, Prisma falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/teleranker?schema=public"

# Optional: a separate database for `pnpm test:db` (PostgreSQL integration
# tests). Its name must end in "_test"; the tests delete its data before each
# case. Create it and apply migrations with `pnpm db:setup-test`.
# On Neon, use the direct (unpooled) connection string here.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/teleranker_test?schema=public"
